# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Phase 0/1 — https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Africa's Talking — OTP SMS (Phase 1 — sandbox is free/instant)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# Supabase Send SMS Hook signing secret (Authentication > Hooks > Send SMS
# Hook, HTTPS endpoint pointing at /api/auth/send-sms-hook)
SEND_SMS_HOOK_SECRET=

# MTN MoMo Developer Portal — each product needs its own subscription key
# AND its own provisioned API user/key (not interchangeable between products).
MOMO_TARGET_ENVIRONMENT=sandbox

# Collections (Phase 2 — contribution/ledger)
MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MOMO_COLLECTIONS_API_USER=
MOMO_COLLECTIONS_API_KEY=

# Disbursements (Phase 3 — payouts/multi-approval)
MOMO_DISBURSEMENTS_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENTS_API_USER=
MOMO_DISBURSEMENTS_API_KEY=

# Remittances (international payments feature) — used by
# lib/momo-remittances.ts / app/api/momo/remittance-status to let staff
# look up an MTN Mobile Money remittance transaction's real status when
# confirming a payment tagged "momo_remittance".
MOMO_REMITTANCES_SUBSCRIPTION_KEY=
MOMO_REMITTANCES_API_USER=
MOMO_REMITTANCES_API_KEY=

# Phase 5 — the MoMo number matching-group members pay their reservation
# deposit to. Blank until Uzuza has an actual dedicated business MoMo
# account (Section 3.5/Phase 7 dependency) — the reserve page shows a
# "being finalized" placeholder until this is set. Client-visible
# (NEXT_PUBLIC_), not a secret.
NEXT_PUBLIC_UZUZA_CUSTODY_MOMO_NUMBER=

# Phase 7 — random secret protecting /api/cron/sweep-out from being called
# by anyone but Vercel's scheduler. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional — overrides the deployed URL scripts/e2e-phase7-check.mjs hits
# directly (rather than waiting for the cron schedule). Defaults to the
# live production URL if unset; only needed to point that script at a
# different deployment.
APP_URL=

# Resend — powers the daily email notification digest
# (/api/cron/email-digest). Sign up free at resend.com, create an API
# key, and paste it here. Without it, lib/email.ts no-ops safely (logs a
# warning, doesn't fail the cron run).
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Uzuza <notifications@yourdomain.com>".
RESEND_FROM_EMAIL=

# Client-visible base URL used in email link buttons. Defaults to the
# live Vercel URL if unset.
NEXT_PUBLIC_SITE_URL=

# Enables real-time MTN MoMo callbacks (X-Callback-Url) instead of
# polling-only. Optional — every MoMo flow works exactly as before
# (polling + the nightly reconciliation cron) if this is left unset.
# Generate with: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
# Also requires NEXT_PUBLIC_SITE_URL above to be set to a real,
# internet-reachable URL (not localhost) for MTN to actually deliver to.
MOMO_CALLBACK_SECRET=

# Sentry — error monitoring. Sign up free at sentry.io, create a Next.js
# project, and it'll give you a DSN plus (optionally) org/project/auth
# token for source-map upload. Without these, Sentry no-ops entirely —
# see sentry.*.config.ts and next.config.ts.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
