# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Phase 0/1 — https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Africa's Talking — OTP SMS (Phase 1 — sandbox is free/instant)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# Supabase Send SMS Hook signing secret (Authentication > Hooks > Send SMS
# Hook, HTTPS endpoint pointing at /api/auth/send-sms-hook)
SEND_SMS_HOOK_SECRET=

# MTN MoMo Developer Portal — each product needs its own subscription key
# AND its own provisioned API user/key (not interchangeable between products).
MOMO_TARGET_ENVIRONMENT=sandbox

# Collections (Phase 2 — contribution/ledger)
MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MOMO_COLLECTIONS_API_USER=
MOMO_COLLECTIONS_API_KEY=

# Disbursements (Phase 3 — payouts/multi-approval)
MOMO_DISBURSEMENTS_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENTS_API_USER=
MOMO_DISBURSEMENTS_API_KEY=

# Remittances — not currently used by any planned Uzuza feature, leave blank
# unless a future release needs cross-border transfer.
MOMO_REMITTANCES_SUBSCRIPTION_KEY=
MOMO_REMITTANCES_API_USER=
MOMO_REMITTANCES_API_KEY=

# Phase 5 — the MoMo number matching-group members pay their reservation
# deposit to. Blank until Uzuza has an actual dedicated business MoMo
# account (Section 3.5/Phase 7 dependency) — the reserve page shows a
# "being finalized" placeholder until this is set. Client-visible
# (NEXT_PUBLIC_), not a secret.
NEXT_PUBLIC_UZUZA_CUSTODY_MOMO_NUMBER=
